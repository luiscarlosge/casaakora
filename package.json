{
  "name": "reserva-de-akora-casa",
  "version": "1.0.0",
  "description": "Sitio web para la venta de vivienda en Reserva de Akora, Tocancipá",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client ci && npm --prefix client run build",
    "test": "node --test test/*.test.js",
    "test:client": "npm --prefix client test",
    "test:all": "npm test && npm run test:client"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
